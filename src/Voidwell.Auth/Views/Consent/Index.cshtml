@model Voidwell.Auth.Models.ConsentViewModel

<div class="page-consent">
    <div class="row page-header">
        <div class="col-sm-10">
            @if (Model.ClientLogoUrl != null)
            {
                <div class="client-logo"><img src="@Model.ClientLogoUrl"></div>
            }
            <h1>
                @Model.ClientName
                <small>is requesting your permission</small>
            </h1>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-8">
            @await Html.PartialAsync("_ValidationSummary")

            <form asp-action="PostConsent" class="consent-form">
                <input type="hidden" asp-for="ReturnUrl" />

                <div>Uncheck the permissions you do not wish to grant.</div>
                
                @if (Model.Scopes.Any())
                {
                    <div class="panel panel-default consent-buttons">
                        <div class="panel-heading">
                            <span class="glyphicon glyphicon-tasks"></span>
                            Requested Permissions
                        </div>
                        <ul class="list-group">
                            @foreach (var scope in Model.Scopes)
                            {
                                @await Html.PartialAsync("_ScopeListItem", scope)
                            }
                        </ul>
                    </div>
                }

                @if (Model.AllowRememberConsent)
                {
                    <div class="consent-remember">
                        <label>
                            <input class="consent-scopecheck" asp-for="RememberConsent" />
                            <strong>Remember My Decision</strong>
                        </label>
                    </div>
                }

                <div class="flex flex-nowrap items-center">
                    <input class="btn btn-primary" name="submit.Accept" type="submit" value="Yes, Allow" />
                    <input class="btn btn-danger" name="submit.Deny" type="submit" value="No, Do Not Allow" />
                    @if (Model.ClientUrl != null)
                    {
                        <a class="grow btn btn-default" target="_blank" href="@Model.ClientUrl">
                            <span class="glyphicon glyphicon-info-sign"></span>
                            <strong>@Model.ClientName</strong>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>
</div>